  "combinations": [
    {
      "when": ["Depth-First Search", "Binary Tree"],
      "patterns": ["tree-dfs"],
      "confidence": "exact",
      "note": "DFS over a binary tree is the tree-DFS pattern by definition."
    },
    {
      "when": ["Depth-First Search", "Binary Search Tree"],
      "patterns": ["tree-dfs"],
      "confidence": "exact"
    },
    {
      "when": ["Breadth-First Search", "Binary Tree"],
      "patterns": ["tree-bfs"],
      "confidence": "exact",
      "note": "Level-order traversal. The single clearest tree-BFS signal there is."
    },
    {
      "when": ["Breadth-First Search", "Tree"],
      "patterns": ["tree-bfs"],
      "confidence": "strong"
    },
    {
      "when": ["Depth-First Search", "Tree"],
      "patterns": ["tree-dfs"],
      "confidence": "strong",
      "note": "'Tree' without 'Binary Tree' also covers n-ary and general trees; still tree-DFS."
    },
    {
      "when": ["Breadth-First Search", "Matrix"],
      "patterns": ["graphs", "matrices"],
      "confidence": "strong",
      "note": "Grid BFS is graph traversal wearing a matrix. Both patterns are genuinely present."
    },
    {
      "when": ["Depth-First Search", "Matrix"],
      "patterns": ["graphs", "matrices"],
      "confidence": "strong"
    },
    {
      "when": ["Breadth-First Search", "Graph Theory"],
      "patterns": ["graphs"],
      "confidence": "exact"
    },
    {
      "when": ["Depth-First Search", "Graph Theory"],
      "patterns": ["graphs"],
      "confidence": "exact"
    },
    {
      "when": ["Depth-First Search", "Union-Find"],
      "patterns": ["union-find", "graphs"],
      "confidence": "strong"
    },
    {
      "when": ["Dynamic Programming", "Binary Tree"],
      "patterns": ["dynamic-programming", "tree-dfs"],
      "confidence": "strong",
      "note": "Tree DP is both, and a learner practising either would want it."
    },
    {
      "when": ["Two Pointers", "Linked List"],
      "patterns": ["fast-slow-pointers"],
      "confidence": "strong",
      "note": "Two pointers over a linked list is nearly always the fast/slow formulation."
    },
    {
      "when": ["Two Pointers", "Sliding Window"],
      "patterns": ["sliding-window"],
      "confidence": "exact",
      "note": "Both tags together describe one technique; the window is the specific claim."
    },
    {
      "when": ["Binary Search", "Matrix"],
      "patterns": ["modified-binary-search", "matrices"],
      "confidence": "strong"
    },
    {
      "when": ["Heap (Priority Queue)", "Merge Sort"],
      "patterns": ["k-way-merge"],
      "confidence": "strong",
      "note": "A heap plus a merge is the k-way merge pattern."
    },
    {
      "when": ["Greedy", "Sorting", "Heap (Priority Queue)"],
      "patterns": ["greedy", "top-k-elements"],
      "confidence": "strong"
    }
  ],

